{
  "name": "@ergishasani/freshclone",
  "version": "0.2.0",
  "description": "Test your README setup instructions in a clean environment.",
  "type": "module",
  "license": "MIT",
  "author": "Ergis Hasani",
  "repository": {
    "type": "git",
    "url": "https://github.com/ergishasani/freshclone.git"
  },
  "bugs": {
    "url": "https://github.com/ergishasani/freshclone/issues"
  },
  "homepage": "https://github.com/ergishasani/freshclone#readme",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "freshclone": "dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "assets",
    "docs/configuration.md",
    "docs/releases.md",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test dist/test/*.test.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run format:check && npm test",
    "prepack": "npm run build",
    "test:integration": "npm run build && node scripts/integration.mjs",
    "package:check": "node scripts/package-check.mjs"
  },
  "dependencies": {
    "mdast-util-from-markdown": "^2.0.2",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
